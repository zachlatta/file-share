# Required: the secret token typed on the OAuth authorize page, and used by
# scripts as "Authorization: Bearer <client_name>:<MCP_SECRET>" (24+ chars).
MCP_SECRET=
# Public origin (https required off loopback).
PUBLIC_URL=http://127.0.0.1:8080
ADDR=127.0.0.1:8080
# Metadata database.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/file_share?sslmode=disable
# Object storage for file bytes (any S3-compatible store; path-style).
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Deleted files and replaced versions are kept this long, then purged.
RETENTION_DAYS=30
MAX_UPLOAD_MB=5120
# Optional: "Sign in with Hack Club" for files restricted to email addresses.
# Create an app at https://auth.hackclub.com with redirect URI
# <PUBLIC_URL>/oauth/callback. Leave both empty to disable.
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
